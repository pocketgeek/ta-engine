# TA Engine Arch package. The CI (linux.yml, arch matrix leg) compiles the
# binaries first (cmake --build build --target taclient taserver, with the
# static SDL2/jpeg/zlib + Bink FFmpeg baked in) and stamps @VERSION@; makepkg
# here only packages the prebuilt binaries -- so every distro leg shares one
# build recipe. Run from this directory: makepkg -f.
pkgname=ta-engine
pkgver=@VERSION@
pkgrel=1
pkgdesc="Clean-room engine recreation of Total Annihilation: Kingdoms"
arch=('x86_64')
url="https://github.com/pocketgeek/ta-engine"
license=('GPL-3.0-or-later')
# Statically linked SDL2/libjpeg/zlib/FFmpeg -> only the C/C++ runtime is a
# hard dependency. SDL2 dlopens its video/audio backends at runtime.
depends=('glibc' 'gcc-libs')
optdepends=('libx11: X11 video backend'
            'wayland: Wayland video backend'
            'pipewire: audio'
            'libpulse: PulseAudio audio'
            'alsa-lib: ALSA audio'
            'libva: Intel/AMD hardware encoding for streaming')
options=('!debug')

package() {
  install -Dm644 "$startdir/../systemd/taserver.service" "$pkgdir/usr/lib/systemd/system/taserver.service"
  install -Dm644 "$startdir/../systemd/taserver-acme.conf" "$pkgdir/usr/share/doc/$pkgname/systemd/taserver-acme.conf"
  install -Dm644 "$startdir/../systemd/taserver-settings.conf" "$pkgdir/usr/share/doc/$pkgname/systemd/taserver-settings.conf"
  install -Dm644 "$startdir/../systemd/README.md" "$pkgdir/usr/share/doc/$pkgname/systemd/README.md"
  install -Dm755 "$startdir/../../build/taclient" "$pkgdir/usr/bin/taclient"
  install -Dm755 "$startdir/../../build/taserver" "$pkgdir/usr/bin/taserver"
  install -Dm755 "$startdir/../../build/cartographer" "$pkgdir/usr/bin/cartographer"
  install -Dm644 "$startdir/../../res/linux/ta-cartographer.desktop" "$pkgdir/usr/share/applications/ta-cartographer.desktop"
  install -Dm644 "$startdir/../../res/icons/cartographer.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/ta-cartographer.png"
  install -Dm644 "$startdir/../../res/linux/ta-client.desktop" "$pkgdir/usr/share/applications/ta-client.desktop"
  install -Dm644 "$startdir/../../res/icons/taclient.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/ta-client.png"
  install -Dm644 "$startdir/../../STREAMING-LICENSES.txt" "$pkgdir/usr/share/licenses/$pkgname/STREAMING-LICENSES.txt"
  install -Dm644 "$startdir/../../EDITOR-FONT-LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/EDITOR-FONT-LICENSE.txt"
  install -Dm644 "$startdir/../../CHAT-FONT-LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/CHAT-FONT-LICENSE.txt"
  install -Dm644 "$startdir/../../TITLE-FONT-LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/TITLE-FONT-LICENSE.txt"
  install -Dm644 "$startdir/../../ACME-LICENSES.txt" "$pkgdir/usr/share/licenses/$pkgname/ACME-LICENSES.txt"
  install -Dm644 "$startdir/../../OPUS-LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/OPUS-LICENSE.txt"
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
